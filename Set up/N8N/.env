# =============================================================================
# n8n stack — environment variables
#
# HOW TO USE:
#   1. Copy this file to a new file named ".env" in the same folder:
#        cp .env.example .env
#   2. Replace every CHANGE_ME value below with a real, strong value.
#   3. Never commit the real ".env" file to Git or share it with anyone.
#      (This .env.example file is safe to share — it has no real secrets.)
# =============================================================================

# --- PostgreSQL credentials ---------------------------------------------------
# These create the database user and database itself on first run.
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
POSTGRES_DB=n8n

# --- n8n security keys --------------------------------------------------------
# Generate a strong random value for each of these on Linux/Mac with:
#   openssl rand -hex 32
# On Windows PowerShell:
#   -join ((48..57)+(97..102)|Get-Random -Count 32|%{[char]$_})
#
# N8N_ENCRYPTION_KEY encrypts all saved credentials in the database.
# Set it once and never change it — changing it locks you out of every
# credential you already saved.
N8N_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Used to sign login session tokens. Can be any long random string.
N8N_JWT_SECRET=CHANGE_ME_generate_another_random_value
